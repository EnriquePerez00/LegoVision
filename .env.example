# LegoVision — Variables de Entorno
# Copia este archivo como .env y rellena los valores

# === Supabase Local (Docker) ===
SUPABASE_URL=http://localhost:5437
SUPABASE_DB_HOST=localhost
SUPABASE_DB_PORT=5434
SUPABASE_DB_NAME=legvision
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=legvision_pass_2024
SUPABASE_ANON_KEY=legvision-anon-key

# === Inference API ===
API_HOST=0.0.0.0
API_PORT=8001
API_RELOAD=true

# === Modelos ===
MODEL_PATH=./runs/train/best.pt
MODEL_DEVICE=mps        # mps (M4 local) | cuda (Lightning AI T4)
INFERENCE_FPS_TARGET=5
CONFIDENCE_THRESHOLD=0.5
IOU_THRESHOLD=0.45

# === Cámara ===
CAMERA_INDEX=0          # índice de la cámara (0 = primera disponible)
CAMERA_TRIGGER_MODE=polling   # polling | trigger (encoder de cinta)
BELT_SPEED_MM_S=83.3   # 5 m/min = 83.3 mm/s

# === Blender Pipeline ===
BLENDER_PATH=/opt/homebrew/Caskroom/blender/5.1.1/Blender.app/Contents/MacOS/Blender
LDRAW_PATH=./data/ldraw
DATASET_OUTPUT=./data/raw_dataset
NUM_IMAGES=1000
PIECES_PER_IMAGE=15

# === Lightning AI ===
LIGHTNING_API_KEY=your_lightning_api_key_here
LIGHTNING_PROJECT=legvision
