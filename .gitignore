*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
*.egg-info/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Jupyter ---
.ipynb_checkpoints/
*.ipynb

# --- Secrets / env ---
.env
.env.*
!.env.example
*.key
*.pem
*.secret
password*.docx
password*.xlsx
password*.txt

# --- IDE / SO ---
.vscode/
.idea/
*.swp
*.swo
*.orig
.clinerules
.DS_Store
**/.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.Spotlight-V100
.Trashes
Thumbs.db

# --- Logs ---
*.log
logs/
**/logs/
pipeline_execution*.log

