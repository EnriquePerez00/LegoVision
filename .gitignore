# ============================================================
#  LegoVision .gitignore
# ============================================================

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
*.egg-info/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Jupyter ---
.ipynb_checkpoints/
*.ipynb

# --- Secrets / env ---
.env
.env.*
!.env.example
*.key
*.pem
*.secret
password*.docx
password*.xlsx
password*.txt

# --- IDE / SO ---
.vscode/
.idea/
*.swp
*.swo
*.orig
.clinerules
.DS_Store
**/.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.Spotlight-V100
.Trashes
Thumbs.db

# --- Logs ---
*.log
logs/
**/logs/
pipeline_execution*.log
mcp_kaggle_logs/

# --- Backups y temporales ---
*.bak
*.backup
*.tmp
*.temp
*.~
.gitignore.backup
**/config.yaml.bak
*.json.bak
*.yaml.bak

# --- Carpetas de exploración / backups locales ---
scratch/
**/scratch/
backups/
**/backups/

# --- Imágenes: NUNCA subir PNGs/JPGs al repositorio ---
*.png
*.jpg
*.jpeg
*.gif
*.bmp
*.tiff
*.webp

# --- Datos pesados regenerables (LDraw, datasets, renders) ---
data/
**/data/
datasets/
**/datasets/
database/rebrickable_cache/
**/rebrickable_cache/

# --- Caches YOLO ---
**/labels/train.cache
**/labels/val.cache
**/labels/test.cache

# --- Reports generados ---
**/report/
**/reports/
**/_bricklink_cache/
**/3dposes/
**/*_report.html
**/*_report.json
piece_report_*.html
**/piece_report_*.html
*.bak_*

# --- JSONs de evaluación/resultados generados ---
eval_report*.json
eval_results*.json
eval_report_*.json
inference_*_eval.json
*_metadata.json
*_eval.json

# --- Caches ---
*_cache.json
stable_poses_cache.json
selected_parts.json

# --- Embeddings ---
*.npy
*.npz
*.pkl
*.pickle

# --- Excel / Office temporales ---
~$*.xlsx
~$*.xls
~$*.docx
*.xlsx
*.xls

# --- Modelos y Pesos (Bloquear todo .pt; solo permitir selectivamente) ---
*.pt
**/*.pt
**/yolo_runs/
**/runs/
**/runs_pose/
**/train_runs/
training/runs/
runs/
mobile_sam.pt
sam2_b.pt
*.zip
**/*.zip

# Excepción: Proteger y forzar el tracking de los modelos validados en la carpeta models/ raíz
!models/
!models/*.pt

# --- Blender ---
*.blend1
*.blend2
/tmp/

# --- Supabase / Docker ---
.supabase/
docker-volumes/

# --- DBs locales ---
*.db
*.sqlite
*.sqlite3

# ============================================================
#  2camaras_random_pieza_unica — Separación de dominios
# ============================================================
2camaras_random_pieza_unica/renders/
!2camaras_random_pieza_unica/renders/.gitkeep
2camaras_random_pieza_unica/reports/
!2camaras_random_pieza_unica/reports/.gitkeep
2camaras_random_pieza_unica/logs/
!2camaras_random_pieza_unica/logs/.gitkeep
!2camaras_random_pieza_unica/renders/**/.gitkeep
!2camaras_random_pieza_unica/reports/**/.gitkeep

blender_out.txt
jobs.txt
