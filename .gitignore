# === LegoVision .gitignore ===

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
*.egg-info/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Jupyter ---
.ipynb_checkpoints/
*.ipynb

# --- Datos pesados: LDraw library (~500MB) ---
# Descargar con: scripts/download_ldraw.sh
data/ldraw/

# --- Datasets generados (imágenes renderizadas por Blender) ---
data/raw_dataset/
data/processed_dataset/
data/test_dataset/
data/temp_inference_run/
data/tmp/

# --- Renders sintéticos generados (se regeneran con scripts/) ---
data/synthetic_renders/
data/simulated_dinov2/

# --- Archivos Excel temporales (lock files de Office) ---
~$*.xlsx
~$*.xls
~$*.docx

# --- Modelos entrenados y pesos ---
*.pt
*.pth
*.onnx
*.engine
*.weights
models/

# --- Resultados de entrenamiento YOLO ---
runs/

# --- Directorio scratch (exploración local, no para el repo) ---
scratch/

# --- Blender temporales ---
*.blend1
*.blend2
/tmp/

# --- Supabase / Docker ---
.supabase/
docker-volumes/

# --- Secrets y variables de entorno ---
.env
.env.local
.env.production
.env.staging
*.key
*.pem
*.secret

# --- macOS ---
.DS_Store
**/.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.Spotlight-V100
.Trashes

# --- IDE ---
.vscode/
.idea/
*.swp
*.swo
*.orig

# --- Logs ---
*.log
logs/
