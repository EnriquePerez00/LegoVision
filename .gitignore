# ============================================================
#  2camaras_random_pieza_unica — Separación de dominios
# ============================================================
# Carpetas de datos generados masivos (renders, reports, logs)
# pero preservar .gitkeep para mantener estructura de carpetas
2camaras_random_pieza_unica/renders/
!2camaras_random_pieza_unica/renders/.gitkeep
2camaras_random_pieza_unica/reports/
!2camaras_random_pieza_unica/reports/.gitkeep
2camaras_random_pieza_unica/logs/
!2camaras_random_pieza_unica/logs/.gitkeep

# Excepción: si existe un subarchivo .gitkeep dentro de subdirs, preservarlo
!2camaras_random_pieza_unica/renders/**/.gitkeep
!2camaras_random_pieza_unica/reports/**/.gitkeep